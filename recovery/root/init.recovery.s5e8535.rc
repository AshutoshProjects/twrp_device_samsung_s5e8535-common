on init
    # Disable hung task timeout
    write /proc/sys/kernel/hung_task_timeout_secs 0

    # Start watchdog daemon
    start watchdogd

    # Unlink and recreate EFS directories
    rm /efs
    mkdir /efs
    mkdir /sec_efs

    # Disable SIOP battery charging path
    write /sys/class/power_supply/battery/siop_level 0

on fs
    # Wait for UFS device
    wait /dev/block/platform/13500000.ufs

    # Create block device symlinks
    symlink /dev/block/platform/13500000.ufs /dev/block/bootdevice
    symlink /dev/block/platform/13500000.ufs/by-name /dev/block/by-name
    symlink /dev/block/platform/13500000.ufs/by-name/param /dev/block/param

    # Set permissions for param block
    chown root system /dev/block/param
    chmod 0666 /dev/block/param

    # Export Android root directory
    export ANDROID_ROOT /system_root

on late-init
    # USB and ADB properties
    setprop sys.usb.controller 13200000.dwc3
    setprop ro.debuggable 1
    setprop service.adb.root 1
    setprop sys.usb.configfs 1
    setprop sys.usb.config adb

on boot
    # Reserved for boot-time commands

# Watchdog service with 30-second timeout, fed every 10 seconds
service watchdogd /system/bin/watchdogd 10 20
    class core
    oneshot
    seclabel u:r:watchdogd:s0