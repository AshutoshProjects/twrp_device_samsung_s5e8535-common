# Create MTP FunctionFS if configfs is enabled
on fs && property:sys.usb.configfs=1
    mkdir /config/usb_gadget/g1/functions/ffs.mtp

# Mount MTP FunctionFS
on fs
    mkdir /dev/usb-ffs/mtp 0770 mtp mtp
    mount functionfs mtp /dev/usb-ffs/mtp uid=2000,gid=2000

# Start ADB when USB config is set to MTP + ADB
on property:sys.usb.config=mtp,adb
    start adbd

# Remove function f2 when USB is disconnected
on property:sys.usb.config=none && property:sys.usb.configfs=1
    rm /config/usb_gadget/g1/configs/b.1/f2

# Configure USB gadget when ready
on property:sys.usb.config=mtp,adb && property:sys.usb.ffs.ready=1 && property:sys.usb.configfs=1
    # Set USB product ID
    write /config/usb_gadget/g1/idProduct 0x04E8

    # Set configuration string
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "fastboot"

    # Create function symlinks
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f1
    symlink /config/usb_gadget/g1/functions/ffs.mtp /config/usb_gadget/g1/configs/b.1/f2

    # Enable the gadget
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}

    # Update USB state property
    setprop sys.usb.state ${sys.usb.config}
