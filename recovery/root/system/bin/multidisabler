#!/system/bin/sh
set -e

# Paths
BOOT_PARTITION="/dev/block/by-name/boot"
TEMP_DIR="/tmp"
OLD_BOOT_IMG="${TEMP_DIR}/old-boot.img"
NEW_BOOT_IMG="${TEMP_DIR}/new-boot.img"
UNPACKED_BOOT_DIR="${TEMP_DIR}/unpacked_boot"

# Cleanup temporary files on exit
cleanup() {
    rm -rf "${UNPACKED_BOOT_DIR}" "${OLD_BOOT_IMG}" "${NEW_BOOT_IMG}"
}
trap cleanup EXIT

echo "Disabling stock recovery restoration..."

# Backup current boot image
dd if="${BOOT_PARTITION}" of="${OLD_BOOT_IMG}" bs=4M

# Unpack boot image
mkdir -p "${UNPACKED_BOOT_DIR}"
cd "${UNPACKED_BOOT_DIR}"
magiskboot unpack -h "${OLD_BOOT_IMG}"

# Repack boot image
magiskboot repack "${OLD_BOOT_IMG}" "${NEW_BOOT_IMG}"
cd -

# Write new boot image
dd if="${NEW_BOOT_IMG}" of="${BOOT_PARTITION}" bs=4M

echo "Stock recovery restoration disabled successfully."